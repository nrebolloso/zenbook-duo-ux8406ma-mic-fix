From: nrebolloso <nrebolloso06@gmail.com>
Subject: [PATCH] ALSA: hda/realtek: Enable headset mic on ASUS Zenbook Duo UX8406MA

The ASUS Zenbook Duo UX8406MA (PCI SSID 1043:1c43) ships with all of the
ALC294 codec's analog input pins (0x18, 0x19, 0x1a) configured as
"unused" (Pin Default 0x411111f0). The existing 1043:1c43 quirk only
attaches the Cirrus CS35L41 speaker amps via ALC245_FIXUP_CS35L41_SPI_2
and provides no pin override, so the codec's auto-parser detects no
analog input and the 3.5mm combo-jack microphone never works on Linux.

Pin 0x19 is the only input pin on this codec with mic-bias capability
(Vref: HIZ 50 GRD 80 100). Override it to a headset-mic pin default and
chain to the existing CS35L41 fixup so the speakers continue to work.

Tested on a UX8406MA running kernel 6.17 with SOF; both the internal
DMIC array and the headset microphone capture cleanly afterwards, and
the CS35L41 speaker DSP firmware loads as before.

Signed-off-by: nrebolloso <nrebolloso06@gmail.com>
---
 sound/hda/codecs/realtek/alc269.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/sound/hda/codecs/realtek/alc269.c b/sound/hda/codecs/realtek/alc269.c
--- a/sound/hda/codecs/realtek/alc269.c
+++ b/sound/hda/codecs/realtek/alc269.c
@@ -3694,6 +3694,7 @@ enum {
 	ALC245_FIXUP_CS35L41_SPI_2_HP_GPIO_LED,
 	ALC245_FIXUP_CS35L41_SPI_4,
 	ALC245_FIXUP_CS35L41_SPI_4_HP_GPIO_LED,
+	ALC245_FIXUP_CS35L41_SPI_2_ASUS_UX8406_HEADSET_MIC,
 	ALC285_FIXUP_HP_SPEAKERS_MICMUTE_LED,
 	ALC295_FIXUP_FRAMEWORK_LAPTOP_MIC_NO_PRESENCE,
 	ALC287_FIXUP_LEGION_16ITHG6,
@@ -5856,6 +5857,15 @@ static const struct hda_fixup alc269_fixups[] = {
 		.chained = true,
 		.chain_id = ALC285_FIXUP_HP_GPIO_LED,
 	},
+	[ALC245_FIXUP_CS35L41_SPI_2_ASUS_UX8406_HEADSET_MIC] = {
+		.type = HDA_FIXUP_PINS,
+		.v.pins = (const struct hda_pintbl[]) {
+			{ 0x19, 0x04a11020 },
+			{ }
+		},
+		.chained = true,
+		.chain_id = ALC245_FIXUP_CS35L41_SPI_2,
+	},
 	[ALC285_FIXUP_HP_SPEAKERS_MICMUTE_LED] = {
 		.type = HDA_FIXUP_VERBS,
 		.v.verbs = (const struct hda_verb[]) {
@@ -6794,7 +6804,7 @@ static const struct hda_quirk alc269_fixup_tbl[] = {
 	SND_PCI_QUIRK(0x1043, 0x1c03, "ASUS UM3406HA", ALC294_FIXUP_ASUS_I2C_HEADSET_MIC),
 	SND_PCI_QUIRK(0x1043, 0x1c23, "Asus X55U", ALC269_FIXUP_LIMIT_INT_MIC_BOOST),
 	SND_PCI_QUIRK(0x1043, 0x1c33, "ASUS UX5304MA", ALC245_FIXUP_CS35L41_SPI_2),
-	SND_PCI_QUIRK(0x1043, 0x1c43, "ASUS UX8406MA", ALC245_FIXUP_CS35L41_SPI_2),
+	SND_PCI_QUIRK(0x1043, 0x1c43, "ASUS UX8406MA", ALC245_FIXUP_CS35L41_SPI_2_ASUS_UX8406_HEADSET_MIC),
 	SND_PCI_QUIRK(0x1043, 0x1c62, "ASUS GU603", ALC289_FIXUP_ASUS_GA401),
 	SND_PCI_QUIRK(0x1043, 0x1c63, "ASUS GU605M", ALC285_FIXUP_ASUS_GU605_SPI_SPEAKER2_TO_DAC1),
 	SND_PCI_QUIRK(0x1043, 0x1c80, "ASUS VivoBook TP401", ALC256_FIXUP_ASUS_MIC_NO_PRESENCE),
